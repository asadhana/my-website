# Local Docker dev environment for zixhr.com
# Copy to .env:  cp .env.example .env
# These are TEST-ONLY credentials for your local machine. Never reuse
# production database credentials here.

# --- MariaDB (local test values) ---
DB_NAME=zixhr_wp
DB_USER=zixhr
DB_PASSWORD=zixhr_local_pw
DB_ROOT_PASSWORD=root_local_pw

# --- WordPress ---
WP_TABLE_PREFIX=wp_
WP_DEBUG=1
# URLs WordPress should use locally. Must match the nginx port below.
WP_HOME=http://localhost:8080
WP_SITEURL=http://localhost:8080

# --- nginx ---
NGINX_HTTP_PORT=8080
